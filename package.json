{
	"name": "obsidx-obsidian",
	"version": "0.1.0",
	"description": "Omnisearch-style semantic search for Obsidian, powered by a local obsidx recall server.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"semantic-search",
		"obsidx",
		"embeddings"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.12.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.21.5",
		"obsidian": "latest",
		"tslib": "^2.6.2",
		"typescript": "^5.4.5",
		"vitest": "^1.6.0"
	}
}
